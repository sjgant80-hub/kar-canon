{
  "name": "kar-canon",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic JSON canonicalisation prover, no LLM judge: are two JSON documents the same data, and if not, where do they differ?",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "agensi": { "selftest": true },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test kernel.test.mjs skill.test.mjs cli.test.mjs",
    "zip": "node make-zip.mjs",
    "gate": "node gate.mjs --witness ../witness/witness.mjs",
    "verify-receipt": "node gate.mjs --verify"
  }
}
